---
interface Props {
  id?: string;
  title: string;
  value: string | number;
  subtitle?: string;
  color?: string;
  icon?: string;
  loading?: boolean;
}

const {
  id,
  title,
  value,
  subtitle = "",
  color = "blue",
  icon = "fa-chart-line",
  loading = false,
} = Astro.props;

const colorMap = {
  blue: {
    bg: "bg-blue-50",
    text: "text-blue-600",
    icon: "bg-blue-100 text-blue-600",
  },
  teal: {
    bg: "bg-teal-50",
    text: "text-teal-600",
    icon: "bg-teal-100 text-teal-600",
  },
  amber: {
    bg: "bg-amber-50",
    text: "text-amber-600",
    icon: "bg-amber-100 text-amber-600",
  },
  purple: {
    bg: "bg-purple-50",
    text: "text-purple-600",
    icon: "bg-purple-100 text-purple-600",
  },
  rose: {
    bg: "bg-rose-50",
    text: "text-rose-600",
    icon: "bg-rose-100 text-rose-600",
  },
};

const theme = colorMap[color] || colorMap.blue;
---

<div
  id={id}
  class={`rounded-2xl border border-gray-100 bg-white p-4 transition-all duration-200 hover:shadow-sm`}
>
  {
    loading ? (
      <div class="animate-pulse">
        <div class="flex items-start justify-between mb-4">
          <div class="space-y-2 flex-1">
            <div class="h-3 w-24 bg-gray-200 rounded"></div>
            <div class="h-7 w-32 bg-gray-200 rounded"></div>
          </div>

          <div class="w-10 h-10 rounded-xl bg-gray-200"></div>
        </div>

        <div class="h-3 w-20 bg-gray-200 rounded"></div>
      </div>
    ) : (
      <>
        <div class="flex items-start justify-between gap-3 mb-3">
          <div class="min-w-0">
            <div
              class="text-[11px] uppercase tracking-wide text-gray-400 font-medium mb-1 truncate"
            >
              {title}
            </div>

            <div
              data-value
              class={`text-xl font-bold leading-none ${theme.text}`}
            >
              {value}
            </div>
          </div>

          <div
            class={`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${theme.icon}`}
          >
            <i class={`fa-solid ${icon} text-sm`}></i>
          </div>
        </div>

        {
          subtitle && (
            <div class="text-[11px] text-gray-400 truncate">
              {subtitle}
            </div>
          )
        }
      </>
    )
  }
</div>