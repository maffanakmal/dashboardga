---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout>
  <div class="min-h-screen flex items-center justify-center p-8 bg-[#f6f8fa]">
    <div class="text-center max-w-md">
      <h1
        class="text-5xl sm:text-6xl font-semibold text-[#24292f] mb-4 leading-none"
      >
        404
      </h1>
      <p class="text-xl font-semibold text-[#24292f] mb-4">Halaman Tidak Ditemukan</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="bg-blue-700 text-white shadow-md font-medium px-4 py-3 rounded-md hover:bg-blue-800 transition-all"
        >
          Kembali
        </a>
      </div>
    </div>
  </div>
</Layout>
